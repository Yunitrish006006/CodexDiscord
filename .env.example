# Credentials for the dedicated Discord Codex Application. Never reuse the
# Minecraft Discord Bridge Bot token and never commit the real token.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Startup refuses to run if the Codex Application matches this Bridge ID.
DISCORD_BRIDGE_APPLICATION_ID=
DISCORD_GUILD_ID=

# Only these Discord users and channels may start a local Codex process.
# Comma-separated Discord snowflakes; both lists must be non-empty.
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=

# Only named workspaces from this JSON map are ever passed to Codex.
CODEX_WORKSPACES_JSON={"alchemy":"/home/thomas/workspace/TotemAlchemy","automata":"/home/thomas/workspace/TotemAutomata","core":"/home/thomas/workspace/TotemCore","discord-bridge":"/home/thomas/workspace/TotemDiscordBridge","enchanting":"/home/thomas/workspace/TotemEnchanting","excavation":"/home/thomas/workspace/TotemExcavation","nexus":"/home/thomas/workspace/TotemNexus","remnant":"/home/thomas/workspace/TotemRemnant","vanilla-tweaks":"/home/thomas/workspace/TotemVanillaTweaks"}

# Adds the special workspace:<workspace> choice for cross-module work. It is
# the only configured path allowed to run outside a single Git repository.
CODEX_WORKSPACE_ROOT=/home/thomas/workspace

# Optional. Use 0 for no time limit; otherwise use 30–7200 seconds.
CODEX_MAX_RUNTIME_SECONDS=0
